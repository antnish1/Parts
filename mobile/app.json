{
  "expo": {
    "name": "Parts Connect",
    "slug": "parts-connect",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "partsconnect",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Parts Connect to scan docket barcodes with the camera.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": { "typedRoutes": false },
    "android": {
      "package": "com.frontier.partsconnect",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A"
      }
    }
  }
}
